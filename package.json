{
	"name": "safe-math-paste",
	"version": "1.0.0",
	"description": "Safely convert AI-generated LaTeX delimiters when pasting into Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "tsx --test tests/transform.test.ts",
		"check": "npm run test && npm run build && npm run lint",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"ai",
		"codex",
		"chatgpt",
		"claude",
		"latex",
		"math",
		"clipboard"
	],
	"author": "Yuming12138",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Yuming12138/safe-math-paste.git"
	},
	"bugs": {
		"url": "https://github.com/Yuming12138/safe-math-paste/issues"
	},
	"homepage": "https://github.com/Yuming12138/safe-math-paste#readme",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.1",
		"esbuild": "^0.28.1",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "^17.8.0",
		"jiti": "^2.7.0",
		"obsidian": "1.12.3",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0"
	}
}
